{
    "name": "playwright@latest",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "devDependencies": {
        "@aws-sdk/client-secrets-manager": "^3.1136.0",
        "@aws-sdk/client-sts": "^3.1136.0",
        "@aws-sdk/credential-providers": "^3.1136.0",
        "@playwright/test": "^1.63.0",
        "@types/bun": "latest",
        "@types/mssql": "^12.3.0",
        "@types/oracledb": "^7.0.3",
        "@types/pg": "^8.23.1",
        "kafkajs": "^2.2.4",
        "mssql": "^12.7.2",
        "oracledb": "^7.0.1",
        "pg": "^8.23.0"
    },
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "npm run clean && tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json",
        "test": "jest --coverage",
        "test-ui": "echo no UI tests",
        "docs": "typedoc --options typedoc.json",
        "typecheck": "tsc --noEmit",
        "prepack": "npm run build",
        "format": "prettier --config .prettierrc --ignore-path .prettierignore --write .",
        "format:check": "prettier --config .prettierrc --ignore-path .prettierignore --check ."
    },
    "peerDependencies": {
        "typescript": "^7"
    },
    "dependencies": {
        "winston": "^3.19.0",
        "xml-js": "^1.6.11"
    }
}
